<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    @if(!head.includes('<title'))
      <title>{{ title }}</title>
    @end
    @each(href in styles)
      <link rel="stylesheet" href="{{ href }}" />
    @end
    {{{ head }}}
  </head>
  <body>
    {{{ body }}}
    @each(src in scripts)
      <script type="module" src="{{ src }}"></script>
    @end
  </body>
</html>

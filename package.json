{
  "name": "exhibition",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "trap 'kill 0' EXIT; vite & bun --watch app/index.ts",
    "build": "vite build && vite build --ssr resources/js/ssr.ts --outDir dist/ssr",
    "start": "NODE_ENV=production bun app/index.ts",
    "migrate": "bun database/migrate.ts",
    "create-admin": "bun database/create-admin.ts",
    "seed": "bun database/seed.ts",
    "test": "bun test",
    "test:pg": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://postgres:postgres@localhost:5433/exhibition_test} bun test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit && node scripts/typecheck-vue.cjs --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@hono/zod-openapi": "^1.6.3",
    "@inertiajs/vue3": "^3.8.0",
    "@lucide/vue": "^1.53.0",
    "@scalar/hono-api-reference": "^0.12.11",
    "edge.js": "^6.5.1",
    "hono": "^4.13.13",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "vue": "^3.5.43",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "^7.0.2",
    "typescript-6": "npm:typescript@^6.0.2",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.12"
  }
}

# development | production
NODE_ENV=development
# A whole number from 1 to 65535.
PORT=3000
APP_NAME=Exhibition

# Development uses SQLite. Production must use PostgreSQL:
# DATABASE_URL=postgres://user:password@host:5432/exhibition
# It must start with sqlite:, postgres: or postgresql:. It is required in production.
DATABASE_URL=sqlite://database/dev.sqlite

# The folder for uploaded files (item photos). It must survive a restart.
STORAGE_DIR=./storage

# How many days a login token stays valid. A number above 0.
TOKEN_TTL_DAYS=30

# Attempt limits in 15 minutes. After that the answer is 429.
# RATE_LIMIT_MAX: wrong logins of one client address for one email, sign-ups per client
# address, and wrong "current password" tries per user.
RATE_LIMIT_MAX=10
# RATE_LIMIT_IP_MAX: wrong logins per client address, and "add a user" calls per user.
RATE_LIMIT_IP_MAX=50
# RATE_LIMIT_EMAIL_MAX: wrong logins for one email from every address together.
RATE_LIMIT_EMAIL_MAX=100

# Used by `bun run seed` only: the password of every test user. Default: exhibition-demo-1
# SEED_PASSWORD=
# Used by `bun run create-admin` only, when there is no terminal to ask for the password.
# ADMIN_PASSWORD=

# How many proxies of your own (nginx, a load balancer) are in front of the app.
# 0: X-Forwarded-For is ignored. The address of the connection is the client.
# 1: the LAST value of X-Forwarded-For is the client (the one your proxy wrote).
# 2: the second value from the right, and so on.
# Behind a proxy you must set it, or every user shares the address of the proxy.
TRUSTED_PROXIES=0

# The API docs page at /docs. Default: true in development, false in production.
# Keep it off in production: the page loads a script from a CDN on the origin of the app.
# API_DOCS=true

# Print one line per request: method, path, status, time. Default: true (false in tests).
# LOG_REQUESTS=true

# Render pages on the server. Needs `bun run build` first.
INERTIA_SSR=false

# Vite dev server. Used only when NODE_ENV is not production.
VITE_DEV_SERVER_URL=http://localhost:5173

# Used by docker-compose only.
POSTGRES_PASSWORD=change-me

# Used by the tests only. When set, the API tests run on this PostgreSQL database.
# Every run empties it first. Never point it at a database with real data.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/exhibition_test
